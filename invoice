#!/bin/zsh
# Wrapper: finds the best available Python and dispatches to the right script.
# Priority: .venv (uv) > conda base > system python3
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

if [[ -x "$SCRIPT_DIR/.venv/bin/python3" ]]; then
  PYTHON="$SCRIPT_DIR/.venv/bin/python3"
elif [[ -x "/opt/anaconda3/bin/python3" ]]; then
  PYTHON="/opt/anaconda3/bin/python3"
else
  PYTHON="python3"
fi

if [[ "$1" == "serve" ]]; then
  shift
  exec "$PYTHON" "$SCRIPT_DIR/serve.py" "$@"
else
  exec "$PYTHON" "$SCRIPT_DIR/generate_invoice.py" "$@"
fi
